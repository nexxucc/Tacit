# Demo is opt-in, synthetic and loopback-only. Production requires migrated PostgreSQL and a GitHub App.
TACIT_DEMO=false
TACIT_HOST=127.0.0.1
TACIT_PORT=8000
TACIT_DATABASE_URL=postgresql+psycopg://tacit:tacit@localhost:5432/tacit
# Clients use explicit, short-lived tokens. Do not put real tokens in this file.
TACIT_API_URL=http://127.0.0.1:8000
# TACIT_TOKEN=
# TACIT_AGENT_TOKEN=
# TACIT_GITHUB_WEBHOOK_SECRET=

# Backend only: configure an existing GitHub App with device flow enabled.
# Permissions: repository Contents read, organization Members read; Metadata read is implicit.
# TACIT_GITHUB_APP_ID=
# TACIT_GITHUB_CLIENT_ID=
# Generate locally with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this encryption key stable and secret; rotating it requires credential re-encryption.
# TACIT_CREDENTIAL_ENCRYPTION_KEY=
# No client secret/private key is needed for device flow. GitHub tokens stay on the backend.
# Expired sessions currently require tacit login again; refresh tokens are not retained.
# Optional isolated PostgreSQL tests; every run creates and drops only its own test schema.
# TACIT_TEST_DATABASE_URL=postgresql+psycopg://tacit:tacit@127.0.0.1:55432/tacit_test
